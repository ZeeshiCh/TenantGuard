{
  "name": "tenantguard",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "pnpm generate:prisma && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "pnpm generate:prisma && node --import tsx --test --test-concurrency=1 tests/*.integration.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm check:portable && pnpm build && pnpm test:packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:portable": "node scripts/check-portable.mjs",
    "test:packages": "node scripts/smoke-packages.mjs",
    "generate:prisma": "node scripts/generate-prisma.mjs",
    "benchmark": "node --import tsx benchmarks/run.ts",
    "test:examples": "node --import tsx --test tests/examples.integration.ts",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/generator-helper": "7.10.1",
    "@testcontainers/postgresql": "^11.10.0",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.16.0",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0",
    "koa": "^3.0.0",
    "mariadb": "^3.5.4",
    "mongodb": "^6.20.0",
    "mongoose": "9.12.0",
    "mysql2": "^3.24.6",
    "pg": "^8.16.0",
    "prettier": "^3.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tarn": "^3.0.2",
    "tedious": "^19.0.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "turbo": "^2.7.0",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3"
  }
}
